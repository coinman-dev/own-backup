# Own Backup engine. Shipped by the .deb into /usr/lib/systemd/system; the
# service's own `--install` only enables it and no longer writes a unit.
#
# What is NOT here, on purpose: every option that gives the service its own
# mount namespace — PrivateTmp, PrivateDevices, ProtectSystem, ProtectHome,
# ProtectKernelTunables/Modules/Logs, ProtectControlGroups, ReadOnlyPaths,
# InaccessiblePaths, TemporaryFileSystem, PrivateMounts. Inside such a
# namespace an image the engine mounts (/run/own-backup-mounts) is invisible to
# the user, and the read-only remount of a busy ESP around its copy would
# change only the service's private view while the real one stays writable.
# Destinations are arbitrary paths (/home, /media, NFS/SMB), and the engine
# writes raw devices, so the file system and the device set stay open too.
# Capabilities are not narrowed either: LVM, cryptsetup, device-mapper, NBD,
# freezing, mlockall and the alarm timer between them need most of root's.

[Unit]
Description=Own Backup engine (scheduled backups for the window and the CLI)
Wants=network-online.target
After=network-online.target remote-fs.target

[Service]
# READY=1 once the socket answers; STOPPING=1 when a stop starts.
Type=notify
NotifyAccess=main
ExecStart=/usr/libexec/own-backup/own-backup-service --run
Restart=on-failure
RestartSec=10
# A stop waits for the running operation to wind down: a durable
# consolidation may take minutes (Windows waits 300 s for it). systemd's
# default 90 s would SIGKILL it mid-write.
TimeoutStopSec=330
# SIGTERM goes to the engine alone, so the tools it runs (snapshot, freeze)
# are not killed under it while it cleans up; whatever is left is killed after.
KillMode=mixed
# /var/lib/own-backup (jobs, history, settings, keys), /var/log/own-backup,
# /run/own-backup (socket, token, freeze markers); mounted copies are in
# /run/own-backup-mounts, which the engine makes itself (0755).
StateDirectory=own-backup
StateDirectoryMode=0750
LogsDirectory=own-backup
LogsDirectoryMode=0750
RuntimeDirectory=own-backup
RuntimeDirectoryMode=0750
# The freeze/remount markers in /run/own-backup/frozen are how a restarted
# engine finds a file system a killed one left frozen. Removing the directory
# at stop would forget them.
RuntimeDirectoryPreserve=yes
UMask=0027
# Hardening that does not need a mount namespace (see the top of this file).
NoNewPrivileges=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
ProtectHostname=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK

[Install]
WantedBy=multi-user.target
