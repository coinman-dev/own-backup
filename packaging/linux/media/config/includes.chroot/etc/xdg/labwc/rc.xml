<?xml version="1.0" encoding="UTF-8"?>
<!--
  labwc on the boot medium (kiosk-desktop): ordinary windows, as on WinPE.
  The window opens maximised (its app id is "own-backup", crates/gui main.rs);
  Alt+Tab and the rest of labwc's default key and mouse bindings stay. The
  empty desktop is our backdrop (own-backup-shell), so clicks on it never reach
  labwc's root menu; menu.xml keeps that menu harmless anyway.
-->
<labwc_config>
  <core>
    <decoration>server</decoration>
    <gap>0</gap>
  </core>
  <theme>
    <cornerRadius>0</cornerRadius>
    <font>
      <name>Sans</name>
      <size>10</size>
    </font>
  </theme>
  <windowSwitcher show="yes" preview="no" outlines="no"/>
  <!--
    One layout for the whole session, not one per window: the strip's
    indicator follows labwc's layout by reading the same keyboards through
    the same keymap (crates/shell/src/linux/keyboard.rs), and a layout that
    changed with the focus would leave it behind. Global is labwc's default;
    said here so that it stays so.
  -->
  <keyboard>
    <default/>
    <layoutScope>global</layoutScope>
  </keyboard>
  <mouse>
    <default/>
  </mouse>
  <windowRules>
    <windowRule identifier="own-backup">
      <action name="Maximize"/>
    </windowRule>
  </windowRules>
</labwc_config>
