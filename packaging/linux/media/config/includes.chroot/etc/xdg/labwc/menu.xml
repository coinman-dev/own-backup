<?xml version="1.0" encoding="UTF-8"?>
<!--
  labwc's root menu, reached only if the strip's backdrop is not there (it is
  restarting). Nothing in it ends the session: no "Exit", no "Reconfigure".
-->
<openbox_menu>
  <menu id="root-menu" label="">
    <item label="Own Backup">
      <action name="Execute" command="/usr/bin/own-backup-gui"/>
    </item>
    <item label="Terminal">
      <action name="Execute" command="foot"/>
    </item>
  </menu>
</openbox_menu>
