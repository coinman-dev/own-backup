# labwc runs this once the screen is up (kiosk-desktop starts labwc on tty1).
# The strip first, so the window opens above it and is maximised to the room
# the strip leaves; the window once — closing it ends nothing, the Start menu
# opens it again (it keeps to one instance itself). The screen size comes before
# both, and is waited for: they size themselves to the screen when they start.
/usr/libexec/own-backup-media/vm-resolution
/usr/libexec/own-backup-media/shell-loop &
/usr/bin/own-backup-gui &
