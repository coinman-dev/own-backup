#!/bin/sh
# `lb build` with its log kept beside the result (scripts/build-linux-media.sh
# shows its end when the build fails). The status is lb's, not tee's.
set -e
status=build.status
{
    rc=0
    lb build noauto "${@}" 2>&1 || rc=$?
    echo "$rc" >"$status"
} | tee build.log
rc="$(cat "$status")"
rm -f "$status"
exit "$rc"
