{
  "name": "own-backup-frontend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "i18n": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide --strategy globalVariable baseLocale --emit-ts-declarations --output-structure locale-modules --no-emit-readme --no-emit-prettier-ignore --silent",
    "i18n:verify": "node ./scripts/i18n-verify.mjs",
    "check": "npm run i18n && npm run i18n:verify && svelte-check --tsconfig ./tsconfig.json",
    "build": "npm run check && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2"
  },
  "devDependencies": {
    "@inlang/paraglide-js": "^2.25.4",
    "@inlang/plugin-message-format": "^4.4.4",
    "@sveltejs/vite-plugin-svelte": "^5",
    "deepmerge": "file:../../../vendor/deepmerge",
    "svelte": "^5",
    "svelte-check": "^4.7.6",
    "typescript": "^5.7",
    "vite": "^6"
  },
  "overrides": {
    "deepmerge": "$deepmerge"
  }
}
