/.ai/
/.claude
/target
/image
**/target
**/node_modules
**/dist
# The patched deepmerge is used from its dist/ (vendor/deepmerge/README-OWN-BACKUP.md).
!/vendor/deepmerge/dist
**/.svelte-kit
**/.vite
**/.vite-temp

**/*.rs.bk
*.obk
*.obk.tmp

.env
.env.*
!.env.example

*.pdb
*.exe
*.dll
# The Total Commander plugin as built (win/), and its install archive.
*.wfx64
win/*.zip
# Release files built locally into win/ (the .exe is caught above).
win/*.deb
win/*.iso
win/SHA256SUMS.txt

.DS_Store
Thumbs.db

cargo
.codex
/design
/log
*.vhdx
*.avhdx
*.obkm

# Mounted Windows test folder (exe, logs, multi-GB backup images)
win-files/

# Local scratch (repros, ad-hoc archives) — never push
/tmp/

__pycache__/
*.pyc

# Linux test binaries
linux-files/

# Windows folders mounted into the tree (drvfs) — not ours to track
/win/disk-*/

# Local project backups (large binary archives) — never commit
/backup/
